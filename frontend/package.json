{
  "name": "refai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:trust-score-ui": "node tests/trust-score-explanation-ui.mjs",
    "test:resume-contract": "node tests/resumeContract.mjs",
