GROQ_API_KEY=replace-with-groq-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
# Required for private resume Storage and trusted database persistence. Never expose this key to the frontend.
SUPABASE_SERVICE_KEY=replace-with-service-role-key
# Optional legacy HS256 secret. Token validation uses the Supabase Auth API.
SUPABASE_JWT_SECRET=
RESUME_STORAGE_BUCKET=resumes
CHROMA_PERSIST_DIR=./chroma_data
AI_APPLY_DEFAULT_MIN_COMPATIBILITY=55
AI_APPLY_MAX_MATCHES=10
AI_APPLY_WEEKLY_REQUEST_CAP=3
AI_APPLY_INITIAL_CREDIT_BALANCE=5
AI_APPLY_SUBMISSION_RATE_LIMIT=6
AI_APPLY_SUBMISSION_RATE_WINDOW_SECONDS=600
CORS_ORIGINS=https://your-frontend.example
